# Copy to .env and fill in. Never commit .env.

# Your MyToyota login (the same one the app keeps asking for)
TOYOTA_USERNAME=you@example.com
TOYOTA_PASSWORD=change-me

# false = miles + UK mpg, true = km + L/100km
USE_METRIC=false

# How often to poll Toyota, in minutes (minimum 10). The car only reports
# after it's been driven or locked, so 30 is plenty.
POLL_MINUTES=30

# Minimum gap between manual "Refresh" button presses, in seconds
REFRESH_COOLDOWN_SECONDS=300

# Optional: set to require a password in the browser (any username works)
DASHBOARD_PASSWORD=

# Optional: the title on the car card. Toyota names every Corolla hatchback
# and estate "Corolla HB/TS"; set this to say which one you have.
CAR_MODEL_NAME=

# Remote control (lock/unlock, hazards, horn, climate, close windows).
# Off by default because it can unlock the car. Buttons need a 3-second hold.
# Commands are refused until DASHBOARD_PASSWORD above is set.
REMOTE_CONTROL=false

# Minimum gap between two remote commands, in seconds
COMMAND_COOLDOWN_SECONDS=15

# true = fake data, no calls to Toyota (for UI work)
MOCK=false
